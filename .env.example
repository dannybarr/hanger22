# Optional. The public site renders with none of these set.
# Copy to .env.local if you want to override them.

# Origin used in the sitemap, feeds, and JSON-LD.
# When unset, those use the request host or https://hanger22.example.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Password for the private /studio ledger. Leave unset to keep /studio on a 404.
# STUDIO_PASSWORD=
